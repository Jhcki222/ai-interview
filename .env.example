# Public Supabase project values (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New API keys also supported instead of legacy anon/service_role:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Apply SQL migrations before enabling AI calls.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
AI_COOKIE_SECRET=

# Next.js gateway. Both services need the same random 32+ character token.
AI_HARNESS_URL=http://127.0.0.1:8000
AI_HARNESS_TOKEN=
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b

# Python service only. In production set these on the Python host.
NVIDIA_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=

NEXT_TELEMETRY_DISABLED=1

# Public Supabase project values (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New API keys also supported instead of legacy anon/service_role:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Apply SQL migrations before enabling AI calls.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
AI_COOKIE_SECRET=

# nvidia (default), groq, ollama or openai. Provider/model can also be selected in the UI.
# Keep all provider keys server-only: never prefix them with NEXT_PUBLIC_.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=
# Optional alternative provider:
OPENAI_API_KEY=

NEXT_TELEMETRY_DISABLED=1

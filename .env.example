# Public Supabase project values (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New API keys also supported instead of legacy anon/service_role:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Apply SQL migrations before enabling AI calls.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
AI_COOKIE_SECRET=

# groq (default) or openai. Never prefix provider secrets with NEXT_PUBLIC_.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Optional alternative provider:
OPENAI_API_KEY=

NEXT_TELEMETRY_DISABLED=1
